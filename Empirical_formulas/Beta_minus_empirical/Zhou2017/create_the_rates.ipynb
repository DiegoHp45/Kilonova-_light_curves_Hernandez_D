   "source": [
    "from __future__ import annotations\n",
    "\n",
    "import math\n",
    "from dataclasses import dataclass\n",
    "from pathlib import Path\n",
    "from typing import Dict, List, Optional, Tuple\n",
    "import pandas as pd\n",
    "import pynucastro as pyna"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "386540f2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Output: Zhou_beta_R1\n",
      "Written beta- rates: 4215\n",
      "Skipped (invalid log arg etc.): 0\n"
     ]
    }
   ],
   "source": [
    "\n",
    "\n",
    "# ----------------------------\n",
    "# Zhou et al. (2017) constants\n",
    "# ----------------------------\n",
    "ALPHA = 1.0 / 137.0\n",
    "\n",
    "# shell parameters\n",
    "A1, A2, A3, A4, A5 = 3.016, 3.879, 1.322, 6.030, 1.669\n",
    "# global parameters\n",
    "A6, A7, A8, A9 = 11.09, 1.07, -0.935, -5.398\n",
    "\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class Nuclide:\n",
    "    Z: int\n",
    "    N: int\n",
    "    A: int\n",
    "    name: str          # reaclib-style token, e.g. \"he3\", \"ni56\"\n",
    "    mex_mev: float     # mass excess in MeV\n",
    "    is_stable: bool\n",
    "\n",
    "\n",
    "# ----------------------------\n",
    "# Helpers\n",
    "# ----------------------------\n",
    "def parity_sign(x: int) -> int:\n",
    "    \"\"\"(-1)^x: +1 if even, -1 if odd.\"\"\"\n",
    "    return 1 if (x % 2 == 0) else -1\n",
    "\n",
    "\n",
    "def pairing_delta(Z: int, N: int) -> int:\n",
    "    \"\"\"δ = (-1)^Z + (-1)^N  => {+2,0,-2}.\"\"\"\n",
    "    return parity_sign(Z) + parity_sign(N)\n",
    "\n",
    "\n",
    "def shell_S(Z: int, N: int) -> float:\n",
    "    \"\"\"Zhou 2017 shell correction S(Z,N).\"\"\"\n",
    "    return (\n",
    "        A1 * math.exp(-(((N - 28) ** 2 + (Z - 20) ** 2) / 12.0))\n",
    "        + A2 * math.exp(-(((N - 50) ** 2 + (Z - 38) ** 2) / 43.0))\n",
    "        + A3 * math.exp(-(((N - 82) ** 2 + (Z - 50) ** 2) / 13.0))\n",
    "        + A4 * math.exp(-(((N - 82) ** 2 + (Z - 58) ** 2) / 24.0))\n",
    "        + A5 * math.exp(-(((N - 110) ** 2 + (Z - 70) ** 2) / 244.0))\n",
    "    )\n",
    "\n",
    "\n",
    "def t12_zhou_seconds(Z: int, N: int, Qb_mev: float) -> Optional[float]:\n",
    "    \"\"\"\n",
    "    Zhou et al. (2017) empirical beta- half-life.\n",
    "    Returns T1/2 [s], or None if invalid (e.g., non-positive log argument).\n",
    "    \"\"\"\n",
    "    A = Z + N\n",
    "    delta = pairing_delta(Z, N)\n",
    "\n",
    "    arg = Qb_mev - A8 * delta  # ln(Q - a8*delta), with a8 = -0.935\n",
    "    if arg <= 0.0:\n",
    "        return None\n",
    "\n",
    "    z2 = float(Z * Z)\n",
    "    a = float(A)\n",
    "    asym = (N - Z) / a\n",
    "\n",
    "    ln_t = (\n",
    "        A6\n",
    "        + (ALPHA**2 * z2 - 5.0 - A7 * asym) * math.log(arg)\n",
    "        + A9 * (ALPHA**2 * z2)\n",
    "        + (1.0 / 3.0) * (ALPHA**2 * z2) * math.log(a)\n",
    "        - ALPHA * Z * math.pi\n",
    "        + shell_S(Z, N)\n",
    "    )\n",
    "\n",
    "    # guard overflow\n",
    "    if ln_t > 700:   # exp(709) ~ 8e307 near float max\n",
    "        return float(\"inf\")\n",
    "    if ln_t < -800:\n",
    "        return 0.0\n",
    "\n",
    "    return math.exp(ln_t)\n",
    "\n",
    "\n",
    "def lambda_from_t12(t12_s: float) -> float:\n",
    "    \"\"\"λ = ln2 / T1/2.\"\"\"\n",
    "    if not math.isfinite(t12_s) or t12_s <= 0.0:\n",
    "        return 0.0\n",
    "    return math.log(2.0) / t12_s\n",
    "\n",
    "\n",
    "# ----------------------------\n",
    "# WinVN reader (robust-ish)\n",
    "# ----------------------------\n",
    "def read_winvn(path: str | Path) -> List[Nuclide]:\n",
    "    \"\"\"\n",
    "    Reads a WinVN-like file where each line contains at least:\n",
    "      idx  Z  A  N  name  mass_excess  [stable_flag ...]\n",
    "    Many WinVN variants exist; this parser is whitespace-based and tolerant.\n",
    "    \"\"\"\n",
    "    nucs: List[Nuclide] = []\n",
    "    nuclei_in_the_reaction=pd.read_csv(r'winvne_v2.0.dat',skiprows=lambda x: not (x>7854 and (x-7855)%4==0),sep=r'\s+',names=['name','A','Z','N','spin','Mass excess (Mev)','source'])\n",
    "    for i in range(len(nuclei_in_the_reaction)):\n",
    "            nucleus=pyna.nucdata.nucleus.Nucleus(nuclei_in_the_reaction['name'][i])\n",
    "            is_stable=False\n",
    "            if nucleus.tau =='stable':\n",
    "                is_stable=True\n",
    "            nucs.append(Nuclide(Z=nucleus.Z, N=nucleus.N, A=nucleus.Z+nucleus.N, name=nuclei_in_the_reaction['name'][i], mex_mev=nuclei_in_the_reaction['Mass excess (Mev)'][i], is_stable=is_stable))\n",
    "\n",
    "    return nucs\n",
    "\n",
    "\n",
    "# ----------------------------\n",
    "# Nstable(Z) construction (as in Zhang/Zhou style)\n",
    "# ----------------------------\n",
    "def solve_A_for_Z_beta_stability(Z: int) -> int:\n",
    "    \"\"\"\n",
    "    For Z where no stable isotopes exist in the table, use the semi-empirical\n",
    "    beta-stability relation (as used in Zhang 2007 to estimate Nstable for Z>=83):\n",
    "        Z ≈ A / (1.98 + 0.0155*A^(2/3))\n",
    "    Solve for A by fixed-point iteration.\n",
    "    \"\"\"\n",
    "    if Z <= 0:\n",
    "        return 0\n",
    "\n",
    "    # crude initial guess: N ~ 1.5 Z => A ~ 2.5 Z\n",
    "    A = max(2 * Z, int(2.5 * Z))\n",
    "\n",
    "    for _ in range(50):\n",
    "        denom = 1.98 + 0.0155 * (A ** (2.0 / 3.0))\n",
    "        A_new = int(round(Z * denom))\n",
    "        if abs(A_new - A) <= 1:\n",
    "            return max(A_new, Z)\n",
    "        A = max(A_new, Z)\n",
    "\n",
    "    return max(A, Z)\n",
    "\n",
    "\n",
    "def build_Nstable_map(nucs: List[Nuclide]) -> Dict[int, int]:\n",
    "    \"\"\"\n",
    "    Build Nstable(Z):\n",
    "      - for even Z: max N among stable nuclides in the file\n",
    "      - for odd Z: average of neighboring even Z (floor)\n",
    "      - if no stable data for Z (e.g., high Z): semi-empirical estimate\n",
    "    \"\"\"\n",
    "    stable_maxN_even: Dict[int, int] = {}\n",
    "\n",
    "    # collect for even Z\n",
    "    for nu in nucs:\n",
    "        if nu.is_stable and (nu.Z % 2 == 0):\n",
    "            stable_maxN_even[nu.Z] = max(stable_maxN_even.get(nu.Z, -10**9), nu.N)\n",
    "\n",
    "    Nstable: Dict[int, int] = {}\n",
    "\n",
    "    Z_values = sorted({nu.Z for nu in nucs})\n",
    "    for Z in Z_values:\n",
    "        if Z % 2 == 0:\n",
    "            if Z in stable_maxN_even:\n",
    "                Nstable[Z] = stable_maxN_even[Z]\n",
    "            else:\n",
    "                # fallback\n",
    "                A_est = solve_A_for_Z_beta_stability(Z)\n",
    "                Nstable[Z] = A_est - Z\n",
    "        else:\n",
    "            # odd Z: average neighbors if possible\n",
    "            left = Z - 1\n",
    "            right = Z + 1\n",
    "            if left in stable_maxN_even and right in stable_maxN_even:\n",
    "                Nstable[Z] = (stable_maxN_even[left] + stable_maxN_even[right]) // 2\n",
    "            elif left in stable_maxN_even:\n",
    "                Nstable[Z] = stable_maxN_even[left]\n",
    "            elif right in stable_maxN_even:\n",
    "                Nstable[Z] = stable_maxN_even[right]\n",
    "            else:\n",
    "                A_est = solve_A_for_Z_beta_stability(Z)\n",
    "                Nstable[Z] = A_est - Z\n",
    "\n",
    "    return Nstable\n",
    "\n",
    "\n",
    "# ----------------------------\n",
    "# REACLIB R1 writer for constant beta- rates\n",
    "# ----------------------------\n",
    "def format_r1_block(parent: Nuclide, daughter: Nuclide, q_mev: float, lam: float, source: str = \"zhou17\") -> str:\n",
    "    \"\"\"\n",
    "    Writes a 3-line REACLIB-R1-like block:\n",
    "      line1: parent daughter (padded) + source + Q\n",
    "      line2: a0..a3\n",
    "      line3: a4..a6\n",
    "    For constant rate: rate(T9)=exp(a0), set a0=ln(lam), others 0.\n",
    "    \"\"\"\n",
    "    # Protect: lambda must be >0\n",
    "    if lam <= 0.0:\n",
    "        a0 = -1.0e99\n",
    "    else:\n",
    "        a0 = math.log(lam)\n",
    "\n",
    "\n",
    "    # line1: keep it whitespace-separated (parsers using split() will work)\n",
    "    line1 = f\"     {parent.name:>5}{daughter.name:>5}\"+\" \"*28+\"wc12w    \"+f\"{q_mev: .5e}\"+\" \"*10\n",
    "    line2 = f\"{a0: .6e}\"+\" 0.000000e+00 0.000000e+00 0.000000e+00                      \"\n",
    "    line3 = \" 0.000000e+00 0.000000e+00 0.000000e+00                                   \"\n",
    "\n",
    "    return line1 + \"\\n\" + line2 + \"\\n\" + line3 + \"\\n\"\n",
    "\n",
    "\n",
    "def write_zhou2017_beta_decay_file(\n",
    "    winvn_path: str | Path,\n",
    "    out_path: str | Path,\n",
    "    *,\n",
    "    z_min: int = 20,\n",
    "    deltaN_min: int = 6,          # δN > 5  => min=6\n",
    "    require_deltaN_cut: bool = True,\n",
    "    skip_stable_parents: bool = True,\n",
    ") -> None:\n",
    "    \"\"\"\n",
    "    Create a file containing beta- decay rates computed with Zhou (2017) for all nuclides in WinVN.\n",
    "\n",
    "    Inputs:\n",
    "      - winvn_path: Winvn_v2.0-like file (must include Z, N, name, mass excess; stable flag helps δN)\n",
    "      - out_path: output text file of 3-line blocks\n",
    "\n",
    "    Filters (recommended):\n",
    "      - Z >= 20\n",
    "      - δN > 5 (i.e., N - Nstable(Z) >= 6)\n",
    "      - Qβ > 0\n",
    "      - daughter exists in network\n",
    "    \"\"\"\n",
    "    nucs = read_winvn(winvn_path)\n",
    "    by_ZN: Dict[Tuple[int, int], Nuclide] = {(nu.Z, nu.N): nu for nu in nucs}\n",
    "    Nstable = build_Nstable_map(nucs)\n",
    "\n",
    "    out_path = Path(out_path)\n",
    "    n_written = 0\n",
    "    n_skipped = 0\n",
    "\n",
    "    with out_path.open(\"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(\"1\"+\" \"*73+\"\\n\")\n",
    "        f.write(\" \"*74+\"\\n\")\n",
    "        f.write(\" \"*74+\"\\n\")\n",
    "\n",
    "        for parent in nucs:\n",
    "            if parent.Z < z_min:\n",
    "                continue\n",
    "            if skip_stable_parents and parent.is_stable:\n",
    "                continue\n",
    "\n",
    "            # Daughter: (Z+1, N-1)\n",
    "            dkey = (parent.Z + 1, parent.N - 1)\n",
    "            daughter = by_ZN.get(dkey)\n",
    "            if daughter is None:\n",
    "                continue\n",
    "\n",
    "            # δN cut\n",
    "            if require_deltaN_cut:\n",
    "                nst = Nstable.get(parent.Z)\n",
    "                if nst is None:\n",
    "                    continue\n",
    "                deltaN = parent.N - nst\n",
    "                if deltaN < deltaN_min:\n",
    "                    continue\n",
    "\n",
    "            # Qbeta from atomic mass excess differences (Au cancels)\n",
    "            Qb = parent.mex_mev - daughter.mex_mev\n",
    "            if Qb <= 0.0:\n",
    "                continue\n",
    "\n",
    "            t12 = t12_zhou_seconds(parent.Z, parent.N, Qb)\n",
    "            if t12 is None:\n",
    "                n_skipped += 1\n",
    "                continue\n",
    "\n",
    "            lam = lambda_from_t12(t12)\n",
    "            block = format_r1_block(parent, daughter, Qb, lam, source=\"zhou17\")\n",
    "            f.write(block)\n",
    "            n_written += 1\n",
    "\n",
    "    print(f\"Output: {out_path}\")\n",
    "    print(f\"Written beta- rates: {n_written}\")\n",
    "    print(f\"Skipped (invalid log arg etc.): {n_skipped}\")\n",
    "\n",
    "\n",
    "# ----------------------------\n",
    "# Example CLI usage\n",
    "# ----------------------------\n",
    "if __name__ == \"__main__\":\n",
    "    # Adjust these paths:\n",
    "    winvn = \"Winvn_v2.0\"  # or your actual path\n",
    "    out = \"Zhou_beta_R1\"\n",
    "\n",
    "    write_zhou2017_beta_decay_file(\n",
    "        winvn_path=winvn,\n",
    "        out_path=out,\n",
    "        z_min=20,\n",
    "        deltaN_min=6,\n",
    "        require_deltaN_cut=True,\n",
    "        skip_stable_parents=True,\n",
    "    )"
   ]
  }
